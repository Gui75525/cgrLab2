{# Data-plane part of /etc/network/interfaces of a leaf (deploy.py keeps the management part).
   Variables: name, node, links, networks, tenants, fabric  (./generate.py --show leaf1) #}
{% set ltenants = networks | map(attribute='tenant') | unique | list %}
auto lo
iface lo inet loopback
    address {{ node.loopback }}/32

{# ---- underlay: routed links to the spines #}
{% for l in links %}
auto {{ l.port }}
iface {{ l.port }}
    address {{ l.address }}
    # to {{ l.peer }} {{ l.peer_port }}

{% endfor %}
{# ---- access ports (untagged, one VLAN each) #}
{% for a in node.access %}
auto {{ a.port }}
iface {{ a.port }}
    bridge-access {{ a.vlan }}

{% endfor %}
{# ---- one VRF per local tenant #}
{% for t in ltenants %}
auto {{ t }}
iface {{ t }}
    vrf-table auto

{% endfor %}
{# ---- L2VNIs: one VXLAN interface per local network #}
{% for n in networks %}
auto vni{{ n.vni }}
iface vni{{ n.vni }}
    vxlan-id {{ n.vni }}
    vxlan-local-tunnelip {{ node.loopback }}
    bridge-access {{ n.vlan }}
    bridge-learning off
    bridge-arp-nd-suppress on

{% endfor %}
{# ---- L3VNIs: one VXLAN interface per local tenant #}
{% for t in ltenants %}
auto vni{{ tenants[t].l3vni }}
iface vni{{ tenants[t].l3vni }}
    vxlan-id {{ tenants[t].l3vni }}
    vxlan-local-tunnelip {{ node.loopback }}
    bridge-access {{ tenants[t].l3vlan }}
    bridge-learning off

{% endfor %}
{# ---- the VLAN-aware bridge #}
auto bridge
iface bridge
    bridge-vlan-aware yes
    bridge-ports{% for a in node.access %} {{ a.port }}{% endfor %}{% for n in networks %} vni{{ n.vni }}{% endfor %}{% for t in ltenants %} vni{{ tenants[t].l3vni }}{% endfor %}

    bridge-vids{% for n in networks %} {{ n.vlan }}{% endfor %}{% for t in ltenants %} {{ tenants[t].l3vlan }}{% endfor %}

    bridge-stp off

{# ---- SVIs: anycast gateway of each local network #}
{% for n in networks %}
auto vlan{{ n.vlan }}
iface vlan{{ n.vlan }}
    vlan-id {{ n.vlan }}
    vlan-raw-device bridge
    address {{ n.gateway }}
    hwaddress {{ fabric.anycast_gateway_mac }}
    arp-accept on
    vrf {{ n.tenant }}

{% endfor %}
{# ---- SVI of each tenant's L3VNI VLAN #}
{% for t in ltenants %}
auto vlan{{ tenants[t].l3vlan }}
iface vlan{{ tenants[t].l3vlan }}
    vlan-id {{ tenants[t].l3vlan }}
    vlan-raw-device bridge
    vrf {{ t }}

{% endfor %}

