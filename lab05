# fabric.yml - the PLAN of the Lab 05 data-center fabric (source of truth).
anycast_gateway_mac: "00:00:5e:00:01:01"

tenants:
  RED:
    l3vni: 5001
    l3vlan: 4001
    networks:
      - {vlan: 10, vni: 10010, gateway: 192.168.10.1/24}
      - {vlan: 20, vni: 10020, gateway: 192.168.20.1/24}
  BLUE:
    l3vni: 5002
    l3vlan: 4002
    networks:
      - {vlan: 30, vni: 10030, gateway: 192.168.10.1/24}

spines:
  spine1: {asn: 65000, loopback: 10.0.0.1}
  spine2: {asn: 65000, loopback: 10.0.0.2}

leaves:
  leaf1:
    asn: 65101
    loopback: 10.0.0.11
    uplinks:
      - {port: swp1, peer: spine1, peer_port: swp1, address: 10.1.1.1/31}
      - {port: swp2, peer: spine2, peer_port: swp1, address: 10.2.1.1/31}
    access:
      - {port: swp3, vlan: 10}   # h1
      - {port: swp4, vlan: 30}   # h5
  leaf2:
    asn: 65102
    loopback: 10.0.0.12
    uplinks:
      - {port: swp1, peer: spine1, peer_port: swp2, address: 10.1.2.1/31}
      - {port: swp2, peer: spine2, peer_port: swp2, address: 10.2.2.1/31}
    access:
      - {port: swp3, vlan: 20}   # h2
  leaf3:
    asn: 65103
    loopback: 10.0.0.13
    uplinks:
      - {port: swp1, peer: spine1, peer_port: swp3, address: 10.1.3.1/31}
      - {port: swp2, peer: spine2, peer_port: swp3, address: 10.2.3.1/31}
    access:
      - {port: swp3, vlan: 10}   # h3
  leaf4:
    asn: 65104
    loopback: 10.0.0.14
    uplinks:
      - {port: swp1, peer: spine1, peer_port: swp4, address: 10.1.4.1/31}
      - {port: swp2, peer: spine2, peer_port: swp4, address: 10.2.4.1/31}
    access:
      - {port: swp3, vlan: 20}   # h4
      - {port: swp4, vlan: 30}   # h6

